#|||----- Applications -----|||#

# Open Terminal (alacritty)
super + Return
	alacritty

super + @space
    # dmenu_run
    OpenApps --menu

# Apps (browser, editor, obsidian)
shift + alt + {b,n,s,m}
	OpenApps {--browser,--filemanager,spotify,mousepad}

shift + super + alt + n
    alacritty -e ranger

#|||----- System Keybindings -----|||#

# jgmenu
~button3
  xqp 0 $(xdo id -N Bspwm -n root) && jgmenu --csv-file=~/.config/bspwm/src/jgmenu/menu.txt --config-file=~/.config/bspwm/jgmenurc

# Power off, Reboot, Log out, Lockscreen, kill an app
ctrl + super + alt + {p,r,o,q,l,k}
	{systemctl poweroff, systemctl reboot,systemctl suspend,bspc quit,physlock -d,xkill}

# Hide/Show Bar (Polybar and/or eww)
super + alt + {g,u}
	HideBar {-h,-u}

# Change transparency on focused window
ctrl + alt + {plus,minus,t}
	picom-trans {-c -o +3,-c -o -1,-c -d}

# Network Manager
# super + alt + n
#	OpenApps --netmanager

# Clipboard
# super + alt + c
super + v
	OpenApps --clipboard

# Screenshot
super + alt + {_,ctrl + }s
	OpenApps {--screenshotselect,--screenshot}

# Manage brightness
XF86MonBrightness{Up,Down}
    sh Brightness {up,down}

# Volume control
XF86Audio{RaiseVolume,LowerVolume,Mute}
	Volume{ --inc, --dec, --toggle}

# Music Control
XF86Audio{Next,Prev,Play,Stop}
	MediaControl {--next,--previous,--toggle,--stop}


#|||----- Bspwm hotkeys -----|||#

# Reload BSPWM
super + alt + r
	bspc wm -r

# close and kill
super + {_,shift + }q
	bspc node -{c,k}
	
# Reload Keybindings
super + Escape
	pkill -USR1 -x sxhkd; dunstify -u low -i ~/.config/bspwm/assets/reload.svg

# set the window state
super + {t,shift + t,s,f}
	bspc node -t {tiled,pseudo_tiled,floating,fullscreen}

# Change focus of the Node or Swap Nodes
shift + super {_,ctrl + }{h,j,k,l}
	bspc node -{f,s} {west,south,north,east}

# Switch workspace
super + {h,l}
	bspc desktop -f {prev,next}.local

# Send focused Node to workspace directionally
super + alt + {h,l}
	bspc node -d {prev,next} '--follow'

# focus or send to the given desktop
super + {_,alt + }{1-9,0}
	bspc {desktop -f,node -d} '^{1-9,10}'

# focus the last node/desktop
super + {comma,Tab}
	bspc {node,desktop} -f last

# expand a window
# ctrl + alt {Left,Down,Up,Right}
ctrl + alt {h,j,k,l}
	bspc node -z {left -10 0,bottom 0 10,top 0 -10,right 10 0}

# contract a window
ctrl + shift + alt + {h,j,k,l}
	bspc node -z {right -10 0,top 0 10,bottom 0 -10,left 10 0}

# move a floating window
alt + shift {h,j,k,l}
	bspc node -v {-10 0,0 10,0 -10,10 0}

# Prev music
super + shift + 8
    playerctl previous

# Pause music
super + shift + 9
    playerctl --player=spotify play-pause

# Next music
super + shift + 0
    playerctl next


# Rewind music by 5 seconds
# super + shift + [
super + shift + bracketleft
    playerctl --player=spotify position 5-

# Advance music by 5 seconds
# super + shift + ]
super + shift + bracketright
    playerctl --player=spotify position 5+

# Decrease volume
super + shift + z 
    pactl set-sink-volume @DEFAULT_SINK@ -2%

# Increase volume
super + shift + x 
    pactl set-sink-volume @DEFAULT_SINK@ +2%

# Mute volume
super + shift + m  
    pactl set-sink-mute @DEFAULT_SINK@ toggle

# Decrease brightness
super + shift + a
    brightnessctl set 5%-

# Increase brightness
super + shift + s 
    brightnessctl set +5%

# Focusing other monitor
alt + ctrl + Tab 
	ChangeMonitor

# Translate highlighted text
super + d
	translate

# Kill translate daemon
ctrl + super + alt + d
    pkill -f "uvicorn server:app"

super + alt + d
    ChangePolybarPos
