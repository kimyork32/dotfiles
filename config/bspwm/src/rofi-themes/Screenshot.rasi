
configuration {
	hover-select:				true;
	me-select-entry:			"";
	me-accept-entry:			"MousePrimary";
}

@import "shared.rasi"

window {
    transparency:                "real";
    location:                    center;
    anchor:                      center;
    fullscreen:                  false;
    width:                       300px;
    x-offset:                    0px;
    y-offset:                    0px;
    margin:                      0px;
    padding:                     0px;
    border:                      1px solid;
    border-radius:               0px;
    border-color:                @gris;
    cursor:                      "default";
    background-color:            @background;
}

mainbox {
    enabled:                     true;
    spacing:                     10px;
    margin:                      0px;
    padding:                     10px;
    background-color:            transparent;
    children:                    [ "inputbar", "message", "listview" ];
}

inputbar {
    enabled:                     false;
    spacing:                     10px;
    padding:                     0px;
    border:                      0px;
    border-radius:               0px;
    border-color:                @gris;
    background-color:            transparent;
    text-color:                  @foreground;
    children:                    [ "textbox-prompt-colon", "prompt"];
}

textbox-prompt-colon {
    enabled:                     false;
    expand:                      false;
    font:                        "JetbrainsMono NF Bold 10";
    str:                         "";
    padding:                     10px 17px 10px 12px;
    border-radius:               0px;
    background-color:            @active;
    text-color:                  @background;
}

prompt {
    enabled:                     true;
    padding:                     10px;
    border-radius:               0px;
    background-color:            @gris;
    text-color:                  @background;
}

message {
    enabled:                     true;
    margin:                      0px;
    padding:                     5px;
    border:                      0px solid;
    border-radius:               0px;
    border-color:                @gris;
    background-color:            @background-alt;
    text-color:                  @foreground;
}

textbox {
    background-color:            inherit;
    text-color:                  inherit;
    vertical-align:              0.5;
    horizontal-align:            0.0;
}

listview {
    enabled:                     true;
    columns:                     5;
    lines:                       1;
    cycle:                       false;
    scrollbar:                   false;
    layout:                      vertical;
    
    background-color:            transparent;
    cursor:                      "default";
}

element {
    enabled:                     true;
    padding:                     0px 0px 0px 0px;
    border:                      1px solid;
    border-radius:               0px;
    border-color:                @gris;
    background-color:            transparent;
    text-color:                  @foreground;
    cursor:                      pointer;
}

element-text {
    font:                        "JetbrainsMono NF Bold 20";
    background-color:            transparent;
    text-color:                  inherit;
    cursor:                      inherit;
    vertical-align:              0.5;
    horizontal-align:            0.5;
}

element normal.normal,
element alternate.normal {
    border:                      0px solid;
    border-radius:               0px;
    border-color:                @gris;
    background-color:            @background;
    text-color:                  @foreground;
}

element normal.urgent,
element alternate.urgent,
element gris.active {
    background-color:            @urgent;
    text-color:                  @background;
}

element normal.active,
element alternate.active,
element gris.urgent {
    background-color:            @active;
    text-color:                  @background;
}

element gris.normal {
    background-color:            @gris;
    text-color:                  @background;
}
